{
  "name": "braintrust",
  "displayName": "Braintrust",
  "version": "0.4.0",
  "description": "Connect Cursor to Braintrust MCP and trace agent sessions.",
  "author": { "name": "Braintrust Data, Inc.", "email": "support@braintrust.dev" },
  "homepage": "https://braintrust.dev",
  "repository": "https://github.com/braintrustdata/braintrust-cursor-extension",
  "license": "MIT",
  "keywords": ["braintrust", "mcp", "ai", "evaluation", "experiments", "observability", "logs", "tracing"],
  "logo": "logo.svg",
  "hooks": "hooks/hooks.json",
  "mcpServers": "mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "BRAINTRUST_API_KEY": {
        "type": "string",
        "title": "Braintrust API key",
        "description": "API key for the Braintrust MCP server"
      }
    },
    "required": ["BRAINTRUST_API_KEY"]
  }
}
